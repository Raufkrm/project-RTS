use crate::app::AppState;
use crate::core::planet_camera::{PlanetScaleCameraPlugin, ScaleFovByAltitude, ScaledWheelZoom};
use crate::core::planet_debug::PlanetDebugPlugin;
use crate::core::unified_planet_camera::{MainCamera, PlanetCamera, UnifiedPlanetCameraPlugin};
use crate::game::world::planet::{spawn_random_planet_inner, update_planet_lod, PlanetParams};
use crate::game::world::sampling::FlatSamplerRes;
use crate::game::world::terrain::MapSettings;
use bevy::prelude::*;
use bevy::log::info;
use bevy::math::primitives::Sphere;

pub mod ui;
pub mod world;

#[derive(Component)]
pub struct InGameRoot;

pub struct GamePlugin;
impl Plugin for GamePlugin {
    fn build(&self, app: &mut App) {
        app.init_resource::<MapSettings>()
            .init_resource::<PlanetParams>()
            .init_resource::<FlatSamplerRes>()
            .add_plugins(PlanetDebugPlugin)
            .add_plugins(PlanetScaleCameraPlugin)
            .add_plugins(UnifiedPlanetCameraPlugin)
            .add_plugins(ui::dev_panel::DevPanelPlugin)
            .add_systems(
                Update,
                update_planet_lod.run_if(in_state(AppState::InGame)),
            )
            .add_systems(OnEnter(AppState::InGame), setup_world);
    }
}

fn setup_world(
    mut commands: Commands,
    mut meshes: ResMut<Assets<Mesh>>,
    mut materials: ResMut<Assets<StandardMaterial>>,
    sampler_res: Res<FlatSamplerRes>,
    map: Res<MapSettings>,
    params: Res<PlanetParams>,
    existing_camera: Query<(), With<MainCamera>>,
    existing_light: Query<(), With<DirectionalLight>>,
) {
    commands.insert_resource(AmbientLight {
        color: Color::srgb(0.25, 0.25, 0.30),
        brightness: 500.0,
        affects_lightmapped_meshes: true,
    });

    spawn_random_planet_inner(
        &mut commands,
        &mut meshes,
        &mut materials,
        &sampler_res,
        &map,
        &params,
    );
    info!("spawned planet with radius {}", params.radius);

    if existing_light.is_empty() {
        commands.spawn((
            DirectionalLight {
                shadows_enabled: true,
                illuminance: 25_000.0,
                ..default()
            },
            TransformBundle::from_transform(Transform::from_rotation(Quat::from_euler(
                EulerRot::XYZ,
                -0.9,
                0.7,
                0.0,
            ))),
            VisibilityBundle::default(),
            Name::new("Sun"),
        ));
        info!("spawned directional light");
    }

    if existing_camera.is_empty() {
        let eye = Vec3::new(0.0, params.radius + 180.0, params.radius + 180.0);
        commands.spawn((
            Camera3d::default(),
            TransformBundle::from_transform(
                Transform::from_translation(eye).looking_at(Vec3::ZERO, Vec3::Y),
            ),
            VisibilityBundle::default(),
            ScaleFovByAltitude {
                near_deg: 55.0,
                far_deg: 85.0,
                far_at_radii: 3.0,
            },
            ScaledWheelZoom {
                base_speed: 120.0,
                speed_per_radius: 1.6,
                smoothing: 0.15,
            },
            PlanetCamera::default(),
            MainCamera,
            Name::new("GameCamera"),
        ));
        info!("spawned main camera at {:?}", eye);
    }

    commands.spawn((
        Mesh3d(meshes.add(Sphere::new(50.0))),
        MeshMaterial3d(materials.add(StandardMaterial {
            base_color: Color::srgb(0.8, 0.2, 0.2),
            ..default()
        })),
        TransformBundle::from_transform(Transform::from_xyz(0.0, params.radius + 60.0, 0.0)),
        VisibilityBundle::default(),
        Name::new("DebugSphere"),
    ));
}
